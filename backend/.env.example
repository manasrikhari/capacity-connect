# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:3000
LIVE_CLIENT_URL=http://localhost:3002

# PostgreSQL Database (Prisma) — Supabase Cloud.
# The backend lives in its own Postgres schema ("backend") of the shared
# Supabase project so its tables never clash with the LMS tables (which use
# "public"). Use the SESSION POOLER host (port 5432 on ...pooler.supabase.com)
# so that `prisma db push` works; the plain db.<ref>.supabase.co host needs
# IPv6 and usually fails on home Wi-Fi. If your DB password has a "+", write it
# as "%2B" in the URL.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=backend"

# JWT Authentication Secrets (classroom access/refresh tokens)
JWT_ACCESS_SECRET="your-super-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-change-in-production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Shared secret for verifying the LMS handoff JWT and signing live-service
# callbacks to the LMS. MUST match LIVE_OPENGRAPES_JWT_SECRET in lms/.env.
# (LMS_JWT_SECRET is accepted as a legacy fallback name for the same value.)
LIVE_OPENGRAPES_JWT_SECRET="generate-a-secure-random-key"

# Base URL of the LMS, used for server-to-server callbacks (session-started,
# doubt, end-class). Default http://localhost:3000.
LMS_API_URL="http://localhost:3000"

# LiveKit Cloud Infrastructure Integration
LIVEKIT_URL="wss://livekit.opengrapes.com"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# Metered TURN credentials (optional — if unset, the API returns STUN-only).
METERED_API_KEY=""
METERED_APP_NAME=""

# AI doubt solver (optional). Gemini for OCR + DeepSeek/SiliconFlow for answers.
# Provide either a single key or up to five rotating keys.
GEMINI_API_KEY=""
# GEMINI_KEY_1="" … GEMINI_KEY_5=""

# Certificate Cryptographic Salt / Secret
CERTIFICATE_SECRET="sih2026-capacity-building-cert-secret-key"
