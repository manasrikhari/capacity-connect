# Postgres connection string used by the app at runtime (Prisma Client).
# Use the pooled connection string from your hosted Postgres provider
# (e.g. Neon/Supabase "pooled" connection, or PgBouncer).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Direct (non-pooled) connection string, used by Prisma Migrate to run
# migrations. Required when DATABASE_URL points at a connection pooler.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth (Auth.js)
# Base URL of the deployed app, e.g. https://your-app.vercel.app
NEXTAUTH_URL="https://your-app.vercel.app"
# Random secret used to sign session tokens — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Google OAuth (used for student sign-in) - see README.md for setup steps.
# Add the production redirect URI in the Google Cloud Console:
# https://your-app.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Signing secret shared with the video call platform and its backend.
# Must match LIVE_OPENGRAPES_JWT_SECRET in backend/.env and live/.env.
LIVE_OPENGRAPES_JWT_SECRET="generate-a-secure-random-key"
# URL of the video call platform UI (http://localhost:3002 for local, or https://live.opengrapes.com)
MEETING_PLATFORM_URL="http://localhost:3002"
# API URL of the video call platform backend (http://localhost:3001 for local, or https://api.live.opengrapes.com)
MEETING_PLATFORM_API_URL="http://localhost:3001"

# Pusher Channels (free Sandbox plan) — create an app at https://dashboard.pusher.com/
# Server-side only — never expose these two outside the server.
PUSHER_APP_ID="your-app-id"
PUSHER_SECRET="your-app-secret"
# Also safe to expose to the browser (see NEXT_PUBLIC_ copies below).
PUSHER_KEY="your-app-key"
PUSHER_CLUSTER="your-app-cluster"

# Client-side copies of the (non-secret) key/cluster above — must match exactly.
NEXT_PUBLIC_PUSHER_KEY="your-app-key"
NEXT_PUBLIC_PUSHER_CLUSTER="your-app-cluster"

# ── Capacity Connect (SIH 26075) ───────────────────────────────────────────
# HMAC secret for signing certificate verification hashes (>= 16 chars).
# Falls back to NEXTAUTH_SECRET in dev; set a dedicated value in production.
CERTIFICATE_SECRET="replace-with-a-random-secret-min-16-chars"

# DeepSeek / SiliconFlow (OpenAI-compatible) — powers MeghDoot & the MCQ
# generator. Unset is fine: every AI feature has a deterministic offline fallback.
DEEPSEEK_API_KEY=""
DEEPSEEK_API_BASE_URL="https://api.siliconflow.com/v1"
DEEPSEEK_MODEL_NAME="deepseek-ai/DeepSeek-V4-Flash"

# Google Gemini (OCR for the live-class doubt tab). Optional.
GEMINI_API_KEY=""

# Directory for trainer-library file uploads (local disk; gitignored).
UPLOAD_DIR="./uploads"
